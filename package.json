{
  "name": "dsh-web-search-lite",
  "version": "1.4.0",
  "type": "module",
  "description": "零依赖的 DSH 联网搜索：DuckDuckGo / Bing / 百度 / 360 聚合去重 + 网页正文读取，免 API Key，可选 Tavily / Serper / Brave / Exa / SearXNG。Zero-dependency web search for DeepSeek Harness, no Playwright, no SQLite.",
  "license": "MIT",
  "author": "leiming2333",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leiming2333/dsh-web-search-lite.git"
  },
  "homepage": "https://github.com/leiming2333/dsh-web-search-lite",
  "bugs": {
    "url": "https://github.com/leiming2333/dsh-web-search-lite/issues"
  },
  "main": "./index.js",
  "scripts": {
    "test": "node _dev/run-tests.mjs",
    "install:profile": "node _dev/install.mjs",
    "diagnose": "node _dev/diagnose.mjs",
    "prepublishOnly": "node _dev/run-tests.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "web-search",
    "search-api",
    "deepseek-harness",
    "duckduckgo",
    "searxng"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
